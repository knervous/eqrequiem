{
  "name": "requiem-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "net:generate": "npm --prefix ../serverjs run net:generate",
    "net:check": "node scripts/check-net-structs-sync.mjs",
    "dependency:check": "node scripts/check-no-sage.mjs",
    "babylon:loader-check": "node scripts/check-babylon-loader.mjs",
    "compression:check": "node --test scripts/compression.test.mjs",
    "motion:check": "node --test scripts/entity-motion.test.mjs",
    "local-backend:check": "node --test scripts/local-backend-connection.test.mjs",
    "render:check": "node --test scripts/render-viewport.test.mjs",
    "sky:check": "node --test scripts/requiem-sky.test.mjs",
    "lighting:check": "node --test scripts/lighting-authority.test.mjs",
    "sky:generate-local": "node scripts/sky-ai/generate-sky-assets.mjs",
    "fx:check": "tsc -p tsconfig.fx.json && node --test scripts/fx-shaders.test.mjs scripts/scene-fx-architecture.test.mjs",
    "character-create:check": "node --test scripts/character-create-catalog.test.mjs",
    "character-select:check": "node --test scripts/character-select-scene.test.mjs",
    "zone-scene:check": "node --test scripts/preprocess-zone-scene.test.mjs",
    "physics-region:check": "node --test scripts/physics-region-streaming.test.mjs",
    "object-material:check": "node --test scripts/object-material-isolation.test.mjs",
    "subapp:check": "node scripts/check-subapp-shells.mjs",
    "shado:check-wgsl": "node scripts/check-shado-wgsl.mjs",
    "validate": "npm run net:check && npm run dependency:check && npm run babylon:loader-check && npm run compression:check && npm run motion:check && npm run local-backend:check && npm run render:check && npm run sky:check && npm run lighting:check && npm run fx:check && npm run character-create:check && npm run character-select:check && npm run zone-scene:check && npm run physics-region:check && npm run object-material:check && npm run subapp:check",
    "v": "vercel dev",
    "atlas": "node scripts/create-atlas.js ~/documents/everquest_rof2/eqrequiem/textures",
    "vat": "node scripts/vat.js ~/documents/everquest_rof2/eqrequiem",
    "bjs:models": "node scripts/bjs-export.js ~/documents/everquest_rof2/eqrequiem/models",
    "model:install-human": "node scripts/install-human-model.js",
    "model:install-human-female": "node scripts/install-human-model.js ../assets/src/models/human_female/runtime/human_female.glb huf",
    "model:install-humans": "npm run model:install-human && npm run model:install-human-female",
    "model:render-reference": "node scripts/render-glb-reference.mjs",
    "model:generate-eq-catalog": "node scripts/generate-eq-catalog-lan.mjs",
    "model:test-eq-catalog": "node --test scripts/generate-eq-catalog-lan.test.mjs",
    "world:promote": "node scripts/promote-shado-worlds.mjs",
    "world:authoring:promote": "npm --prefix ../shader-object run build && node scripts/promote-authored-zone.mjs",
    "world:objects:promote": "node scripts/promote-zone-object-assets.mjs",
    "world:objects:authored:promote": "node scripts/promote-authored-zone-objects.mjs",
    "world:objects:replace:review": "node scripts/object-replacement-pipeline.mjs review",
    "world:objects:replace:prepare-qeynos2": "node scripts/prepare-qeynos2-object-review.mjs",
    "world:objects:replace:first-pass-clean:qeynos2": "node scripts/clean-qeynos2-first-pass-objects.mjs",
    "world:objects:replace:summarize-qeynos2": "node scripts/summarize-qeynos2-object-review.mjs",
    "world:objects:replace:legacy-pbr": "node scripts/object-replacement-pipeline.mjs legacy-pbr-generate",
    "world:objects:replace:stablegen": "node scripts/run-qeynos2-stablegen-queue.mjs",
    "world:objects:replace:stablegen:qeynos2": "node scripts/run-qeynos2-stablegen-queue.mjs",
    "world:objects:replace:hunyuan:qeynos2": "node scripts/generate-qeynos2-hunyuan-clean-room-objects.mjs --resume",
    "world:objects:replace:hunyuan:rof2-multiview:qeynos2": "node scripts/generate-qeynos2-hunyuan-clean-room-objects.mjs --resume",
    "world:objects:replace:approve-dark-fantasy:qeynos2": "node scripts/approve-qeynos2-dark-fantasy-promotion.mjs --owner-approved",
    "world:objects:replace:spar3d:barrel": "node scripts/generate-spar3d-clean-room-barrel-example.mjs",
    "world:objects:replace:promote": "node scripts/object-replacement-pipeline.mjs promote",
    "world:minimap:bake": "node scripts/bake-zone-minimap.mjs",
    "world:lighting:bake": "npm --prefix ../shader-object run build && node scripts/lighting/bake-zone-lighting.mjs",
    "item:icons:promote": "node scripts/promote-item-icons.mjs",
    "icon-ai:migrate": "node scripts/migrate-legacy-icons.mjs",
    "icon-ai:audit": "node scripts/migrate-legacy-icons.mjs audit",
    "icon-ai:promote": "node scripts/migrate-legacy-icons.mjs promote",
    "icon-ai:all": "node scripts/migrate-legacy-icons.mjs all",
    "icon-ai:local": "node scripts/icon-ai/sdcpp-tool.mjs",
    "icon-ai:migrate:test": "node --test scripts/icon-ai/sprite-pipeline.test.mjs",
    "material-ai:zone": "node scripts/material-ai/zone-material-pipeline.mjs",
    "material-ai:test": "node --test scripts/material-ai/*.test.mjs",
    "world:baseline": "npm --prefix ../shader-object run build && node scripts/build-legacy-zone-baseline.mjs",
    "world:baseline:dry-run": "node scripts/build-legacy-zone-baseline.mjs --dry-run",
    "world:baseline:check": "node scripts/build-legacy-zone-baseline.mjs --check",
    "world:runtime:check": "node scripts/audit-promoted-world-runtime.mjs",
    "model:audit-rig": "node scripts/audit-humanoid-rig.mjs",
    "model:transplant-eq-rig": "node scripts/transplant-eq-rig.mjs",
    "bjs:items": "node scripts/bjs-export-full.js ~/documents/everquest_rof2/eqrequiem/items",
    "bjs:objects": "node scripts/bjs-export-full.js ~/documents/everquest_rof2/eqrequiem/objects",
    "bjs:zones": "node scripts/bjs-export-full.js ~/documents/everquest_rof2/eqrequiem/zones",
    "bjs:sky": "node scripts/bjs-export-full.js ~/documents/everquest_rof2/eqrequiem/sky",
    "bjs:all": "npm-run-all bjs:items bjs:objects bjs:zones bjs:sky",
    "upload": "node scripts/upload.js ~/documents/everquest_rof2",
    "upload:db": "node scripts/upload-db.js",
    "start": "cross-env VITE_LOCAL_DEV=true vite",
    "start:http": "cross-env VITE_LOCAL_DEV=true VITE_LOCAL_HTTP_QA=true vite",
    "start:prod": "cross-env VITE_LOCAL_DEV=false vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint src --tsconfig tsconfig.json --react-plugin --import-plugin --deny-warnings --report-unused-disable-directives",
    "preview": "vite preview"
  },
  "dependencies": {
    "@babylonjs/addons": "9.16.1",
    "@babylonjs/core": "^9.5.0",
    "@babylonjs/gui": "9.16.1",
    "@babylonjs/gui-editor": "9.16.1",
    "@babylonjs/havok": "^1.3.10",
    "@babylonjs/inspector": "^9.5.0",
    "@babylonjs/lite": "1.14.0",
    "@babylonjs/loaders": "^9.5.0",
    "@babylonjs/materials": "^9.5.0",
    "@babylonjs/serializers": "^9.5.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fluentui-contrib/react-resize-handle": "^0.8.4",
    "@fluentui-contrib/react-virtualizer": "^1.0.0",
    "@fluentui/react-components": "^9.73.8",
    "@fluentui/react-icons": "^2.0.325",
    "@knervous/shado": "file:../shader-object",
    "@mui/icons-material": "^7.0.2",
    "@mui/material": "^7.0.2",
    "@mui/x-tree-view": "^7.26.0",
    "@protobuf-ts/runtime": "^2.9.6",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@recast-navigation/core": "^0.43.1",
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "allotment": "^1.20.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fantasy-name-generator": "^2.0.0",
    "gl-matrix": "^3.4.3",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.577.0",
    "maxrects-packer": "^2.7.3",
    "mitt": "^3.0.1",
    "pako": "^2.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0",
    "react-social-login-buttons": "^4.1.1",
    "slate": "^0.117.2",
    "slate-dom": "0.117.4",
    "slate-history": "^0.113.1",
    "slate-react": "^0.117.4",
    "sparse-octree": "^7.1.8",
    "tailwind-merge": "^3.5.0",
    "tga-js": "^1.1.1",
    "use-context-selector": "^2.0.0",
    "use-debounce": "^10.0.4",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.4.3"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom"
  },
  "devDependencies": {
    "@aaronhayes/hasura-cli": "^2.42.0",
    "@azure/identity": "^4.9.0",
    "@azure/storage-blob": "^12.27.0",
    "@gltf-transform/core": "^4.4.1",
    "@itk-viewer/blosc-zarr": "^0.2.3",
    "@protobuf-ts/plugin": "^2.9.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vercel/node": "^5.8.27",
    "@vingle/bmp-js": "^0.2.5",
    "@vitejs/plugin-react": "^6.0.4",
    "archiver": "^7.0.1",
    "autoprefixer": "^10.5.4",
    "cross-env": "^10.1.0",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "http-server": "^14.1.1",
    "jimp": "^1.6.0",
    "ktx-parse": "^1.0.0",
    "node-fetch": "^3.3.2",
    "node-lame": "^1.3.2",
    "npm-run-all": "^4.1.5",
    "onnxruntime-node": "^1.27.0",
    "oxlint": "^1.75.0",
    "p-limit": "^6.2.0",
    "postcss": "^8.5.23",
    "rollup": "^4.62.3",
    "serve-static": "^1.16.2",
    "sharp": "^0.34.1",
    "sharp-bmp": "^0.1.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "vercel": "^41.4.1",
    "vite": "^8.1.5"
  }
}
